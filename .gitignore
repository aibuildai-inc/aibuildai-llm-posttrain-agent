# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.env
.venv
venv/

# Build artifacts
dist/
# The Web display frontend ships its built dist as a committed generated
# tree (regenerated by `npm run build` on any frontend change); only the
# package manager's tree stays local.
!output/web/frontend/dist/
output/web/frontend/node_modules/
build/
*.tar.gz
_version.py

# Runtime / output
out/
*.log
logs/
playground
public/
.pipeline/
cache/
tmp/
train.pid
catboost_info/
*.pt
results.csv
references/
configs/

# Data
data/
kaggle.json

# Generated by `pip install -e .` — package metadata, regenerated on every install.
/aibuildai.egg-info/

# Archives
*.zip

# Only the gate scripts check.sh runs are tracked under scripts/. Use
# `scripts/*` (not `scripts/`) so the file-level `!` exceptions take effect:
# git refuses to re-include a file if its parent directory is excluded.
scripts/*
!scripts/check_agent_public_members.py
!scripts/check_lock_drift.py
!scripts/check_skill_examples.py
!scripts/gen_reference.py

# Plugins: re-include scripts/ and references/ dirs ignored by generic rules above
!plugins/**/scripts/
!plugins/**/scripts/**
!plugins/**/references/
!plugins/**/references/**

# Locally generated run artifacts -- never committed, but they dirty `git status`,
# which makes a `git pull` look like it dumped files.
snapshot_report.html

# OS metadata files. Finder writes .DS_Store into every directory it opens, so a
# contributor on macOS otherwise commits them across the tree.
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
