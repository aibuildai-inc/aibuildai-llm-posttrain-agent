{
  "name": "aibuildai-web-display",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run gen-api && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "gen-api": "cd ../../.. && python -m output.web.app > output/web/frontend/openapi.json && python -m output.web.app --hash > output/web/frontend/src/api/schema.hash && cd output/web/frontend && openapi-typescript openapi.json -o src/api/schema.d.ts && rm openapi.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@shikijs/rehype": "^4.4.3",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.11.3",
    "echarts": "^6.1.0",
    "elkjs": "^0.12.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^1.33.0",
    "mermaid": "^11.17.0",
    "motion": "^13.1.0",
    "openapi-fetch": "^0.14.1",
    "playwright": "^1.62.1",
    "react": "^19.2.0",
    "react-aria-components": "^1.13.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.5.0",
    "react-resizable-panels": "^4.12.3",
    "react-router-dom": "^7.9.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gemoji": "^8.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0",
    "openapi-typescript": "^7.9.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0"
  }
}
